{
  "name": "10_resolve_ai_activity_stream",
  "nodes": [
    {
      "parameters": {},
      "id": "10-trigger",
      "name": "Activity Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        100,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://localhost:8000/api/cases/{{ $json.case_id || 'case_test_01' }}/activity",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "case_id",
              "value": "={{ $json.case_id || 'case_test_01' }}"
            },
            {
              "name": "agent",
              "value": "={{ $json.agent || 'PAYMENT_AGENT' }}"
            },
            {
              "name": "activity",
              "value": "={{ $json.activity || 'INVESTIGATING' }}"
            },
            {
              "name": "message",
              "value": "={{ $json.message || 'Investigating payment mismatch telemetry' }}"
            },
            {
              "name": "status",
              "value": "={{ $json.status || 'RUNNING' }}"
            }
          ]
        }
      },
      "id": "10-emit",
      "name": "1. Emit AI Worker Floor Activity",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        360,
        200
      ]
    }
  ],
  "connections": {
    "Activity Trigger": {
      "main": [
        [
          {
            "node": "1. Emit AI Worker Floor Activity",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true
}