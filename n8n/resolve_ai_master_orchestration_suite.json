    {
      "parameters": {
        "jsCode": "// Step 5: Cognee Policy Knowledge Retrieval\nconst caseData = $('1. Ingest Case & Telemetry').first().json;\nconst paymentData = $('2. Payment Simulator Check').first().json;\nconst orderData = $('3. Merchant Order Check').first().json;\nconst productData = $('4. Inventory Stock Check').first().json;\n\nconst policyTopics = [\n  { topic: 'Order Recovery Policy', rule: 'When payment succeeds and stock is available (>0), AI proposes order recovery without double-charge.', confidence: 0.98 },\n  { topic: 'High-Value Refund Threshold', rule: 'Refunds equal to or exceeding \u20b9500 require manager approval before disbursement.', threshold: 500.00, confidence: 0.95 }\n];\n\nreturn {\n  case_id: caseData.case_id,\n  customer_id: caseData.customer_id,\n  customer_request: caseData.customer_request,\n  backend_url: caseData.backend_url,\n  payment: paymentData,\n  order: orderData,\n  product: productData,\n  knowledge_results: policyTopics,\n  cognee_status: 'SYNCHRONIZED',\n  policy_verified: true\n};\n"
      },
      "id": "node-cognee",
      "name": "5. Cognee Policy Knowledge Search",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1660,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "// Step 6: AI Decision Synthesis (AI PROPOSES. CODE DECIDES.)\nconst data = $input.first().json;\nconst payment = data.payment || {};\nconst order = data.order || {};\nconst product = data.product || {};\n\nlet decision = 'OFFER_ORDER_RECOVERY';\nlet proposedAction = 'ORDER_RECOVERY';\nlet requiresApproval = false;\nlet reason = '';\n\nif (payment.status === 'SUCCESS' && !order.found && product.available) {\n  decision = 'OFFER_ORDER_RECOVERY';\n  proposedAction = 'ORDER_RECOVERY';\n  reason = `Verified payment of \u20b9${payment.amount} for ${product.name}. Order missing in ERP. Stock available (${product.quantity} units). Proposing order recovery.`;\n} else if (payment.status === 'SUCCESS' && !order.found && !product.available) {\n  decision = 'OFFER_REFUND';\n  proposedAction = 'REFUND';\n  requiresApproval = payment.amount >= 500.00;\n  reason = `Payment verified \u20b9${payment.amount}, but ${product.name} is out of stock. Refund proposed (Approval required: ${requiresApproval}).`;\n} else if (payment.status === 'SUCCESS' && order.found) {\n  decision = 'SHOW_EXISTING_ORDER';\n  proposedAction = 'CONFIRM_EXISTING_ORDER';\n  reason = `Order ${order.order_number} already exists and payment is linked.`;\n} else {\n  decision = 'CONFLICT_ESCALATE';\n  proposedAction = 'ESCALATE';\n  reason = 'Evidence discrepancy. Assigned to human support specialist.';\n}\n\nreturn {\n  ...data,\n  step: '6_AI_DECISION_SYNTHESIS',\n  decision: decision,\n  proposed_action: proposedAction,\n  requires_approval: requiresApproval,\n  reason: reason,\n  ai_decision_status: 'SUCCESS'\n};"
      },
      "id": "node-ai-decision",
      "name": "6. AI Teammate Decision Synthesis",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1900,
        400
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.proposed_action }}",
                    "rightValue": "ORDER_RECOVERY",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "Order Recovery"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.proposed_action }}",
                    "rightValue": "REFUND",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "Refund"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.proposed_action }}",
                    "rightValue": "ESCALATE",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "Escalation"
            }
          ]
        }
      },
