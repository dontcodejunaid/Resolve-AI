    },
    {
      "parameters": {
        "jsCode": "// Step 1: Ingest Case Context & Configure Endpoint\nconst input = $input.first()?.json || {};\nconst body = input.body || input;\n\nreturn {\n  case_id: body.case_id || 'case_101_headset',\n  customer_id: body.customer_id || 'cust_901',\n  customer_request: body.customer_request || 'Payment deducted for Wireless Headset, but no order placed.',\n  payment_reference: body.payment_reference || 'pay_test_headset_01',\n  product_id: body.product_id || 'prod_headset',\n  amount: body.amount || 799.00,\n  currency: body.currency || 'INR',\n  backend_url: body.backend_url || 'https://favorite-panama-pester.ngrok-free.dev'\n};"
      },
      "id": "node-ingest",
      "name": "1. Ingest Case & Telemetry",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($('1. Ingest Case & Telemetry').first().json.backend_url || 'https://favorite-panama-pester.ngrok-free.dev') }}/api/cases/{{ $('1. Ingest Case & Telemetry').first().json.case_id }}/activity",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "ngrok-skip-browser-warning",
              "value": "true"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "case_id",
              "value": "={{ $('1. Ingest Case & Telemetry').first().json.case_id }}"
            },
            {
              "name": "agent",
              "value": "PAYMENT_AGENT"
            },
            {
              "name": "activity",
              "value": "VERIFYING_PAYMENT"
            },
            {
              "name": "message",
              "value": "=Verifying transaction {{ $('1. Ingest Case & Telemetry').first().json.payment_reference }} with payment gateway simulator..."
            },
            {
              "name": "status",
              "value": "RUNNING"
            }
          ]
        }
      },
      "id": "node-emit-pay",
