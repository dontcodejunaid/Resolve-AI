            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "4. Query Cognee Policy Knowledge": {
      "main": [
        [
          {
            "node": "5. AI Structured Decision Engine",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "5. AI Structured Decision Engine": {
      "main": [
        [
          {
            "node": "6. Action Router",
