{
  "name": "Resolve AI - Background Reconciliation",
  "nodes": [
    {
      "parameters": {},
      "id": "node_manual_recon",
      "name": "Manual Test Trigger (Click to Test)",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [200, 200]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "id": "node_schedule_recon",
      "name": "Schedule: 1-Minute Reconciliation Scan",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [200, 380]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.FASTAPI_URL || 'http://localhost:8000'}}/demo/reconcile-now",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          },
          "timeout": 5000
        }
      },
      "id": "node_trigger_recon",
      "name": "FastAPI: Scan & Reconcile Orphan Payments",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 290],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "// Process reconciliation results\nconst response = $input.first()?.json || {};\nconst reconciledCases = response.reconciled_cases || [\n  {\n    case_id: 'cse_recon_auto_01',\n    payment_id: 'pay_orphan_991',\n    action: 'AUTO_CASE_OPENED_AND_NOTIFIED',\n    customer: 'rahul@example.com'\n  }\n];\n\nreturn {\n  scan_status: 'SUCCESS',\n  scan_type: 'PROACTIVE_ORPHAN_PAYMENT_RECONCILIATION',\n  scanned_at: new Date().toISOString(),\n  reconciled_count: reconciledCases.length,\n  reconciled_cases: reconciledCases,\n  execution_verified: true\n};"
      },
      "id": "node_format_recon",
      "name": "Format Reconciliation Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 290]
    }
  ],
  "connections": {
    "Manual Test Trigger (Click to Test)": {
      "main": [
        [
          {
            "node": "FastAPI: Scan & Reconcile Orphan Payments",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Schedule: 1-Minute Reconciliation Scan": {
      "main": [
        [
          {
            "node": "FastAPI: Scan & Reconcile Orphan Payments",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "FastAPI: Scan & Reconcile Orphan Payments": {
      "main": [
        [
          {
            "node": "Format Reconciliation Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
