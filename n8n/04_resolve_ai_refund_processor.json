        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://localhost:8000/api/refunds",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "case_id",
              "value": "={{ $json.case_id || 'case_test_01' }}"
            },
            {
              "name": "payment_reference",
              "value": "={{ $json.payment_reference || 'pay_test_01' }}"
            },
            {
              "name": "amount",
              "value": "={{ $json.amount || 799.00 }}"
            },
            {
              "name": "reason",
              "value": "Item out of stock"
            },
            {
              "name": "idempotency_key",
              "value": "={{ ($json.case_id || 'case_test_01') + '_REFUND' }}"
            }
          ]
        }
      },
      "id": "04-exec-ref",
      "name": "2. Authoritative Refund Execution",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        620,
        200
      ]
    }
  ],
  "connections": {
    "Trigger": {
      "main": [
        [
          {
