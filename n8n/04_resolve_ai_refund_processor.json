{
  "name": "04_resolve_ai_refund_processor",
  "nodes": [
    {
      "parameters": {},
      "id": "04-trigger",
      "name": "Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        100,
        200
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=http://localhost:8000/api/refunds/search?payment_reference={{ $json.payment_reference || 'pay_test_01' }}"
      },
      "id": "04-search-ref",
      "name": "1. Search Existing Refunds",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
